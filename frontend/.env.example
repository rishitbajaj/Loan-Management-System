# Browser calls same-origin /api, which Next.js rewrites to this backend.
# Local development (Express on this machine):
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional explicit rewrite target (used by next.config if set).
# BACKEND_URL=http://localhost:5000

# Vercel production: set NEXT_PUBLIC_API_URL in the Vercel project env (not in git).
# Use the Render API origin plus /api — never localhost.
# NEXT_PUBLIC_API_URL=https://loan-management-system-9av6.onrender.com/api
