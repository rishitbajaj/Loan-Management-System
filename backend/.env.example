# Server
PORT=5000
NODE_ENV=development

# Local MongoDB (default port 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# MongoDB Atlas (alternative — replace local URI above)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS. Comma-separated list of frontend origins (no trailing slash).
# Local only:
CLIENT_URL=http://localhost:3000
# Production (Render): exact Vercel origin, plus localhost if you still develop against it.
# CLIENT_URL=https://your-app.vercel.app
# CLIENT_URL=https://your-app.vercel.app,http://localhost:3000

# Where salary slips are stored on disk (relative to backend/). Never served statically.
UPLOAD_DIR=uploads
